<Window x:Class="VamPackageUpdater.ReferenceOccurrencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="References"
        Width="1000" Height="620"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1e1e1e" Foreground="#e0e0e0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Dark scrollbar (mirrors MainWindow's style) -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#3f3f3f" CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5a5a5a"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6a6a6a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="DarkScrollBarVertical" TargetType="ScrollBar">
            <Grid Background="#141414">
                <Track Name="PART_Track" IsDirectionReversed="True">
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="DarkScrollBarHorizontal" TargetType="ScrollBar">
            <Grid Background="#141414">
                <Track Name="PART_Track">
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Opacity="0" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Opacity="0" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource DarkScrollBarVertical}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource DarkScrollBarHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#3f3f3f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5a5a5a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox item with file icon / line / category -->
        <Style x:Key="OccurrenceItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#dcdcdc"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock>
                <Run x:Name="HeaderPluginRun" FontWeight="Bold" FontSize="15" Foreground="#4EC9B0"/>
                <Run x:Name="HeaderCountRun" Foreground="#9a9a9a" FontSize="13"/>
            </TextBlock>
            <TextBlock x:Name="HeaderHintRun" Foreground="#808080" FontSize="12" Margin="0,4,0,0"
                       Text="Select an occurrence on the left to see where it sits in the file."/>
        </StackPanel>

        <!-- Body: list + detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Occurrences list -->
            <Border Grid.Column="0" Background="#151515" BorderBrush="#2a2a2a" BorderThickness="1">
                <ListBox x:Name="OccurrenceList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource OccurrenceItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OccurrenceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="#9CDCFE" TextWrapping="Wrap"
                                           Text="{Binding File}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="#808080" Text="line "/>
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="#DCDCAA" FontFamily="Cascadia Mono, Consolas"
                                               Text="{Binding Line}"/>
                                    <Border Margin="10,0,0,0" Padding="6,1" VerticalAlignment="Center"
                                            Background="#2d2d2d" BorderBrush="#3f3f3f" BorderThickness="1">
                                        <TextBlock FontSize="11" Foreground="#CE9178"
                                                   Text="{Binding CategoryLabel}"/>
                                    </Border>
                                    <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="#808080" Text="v"/>
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="#B5CEA8" FontFamily="Cascadia Mono, Consolas"
                                               Text="{Binding Version}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#1e1e1e"/>

            <!-- Snippet detail -->
            <Border Grid.Column="2" Background="#0f0f0f" BorderBrush="#2a2a2a" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#181818" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock x:Name="DetailFileRun" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="#9CDCFE" TextWrapping="Wrap"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Padding="10,8">
                        <TextBlock x:Name="SnippetBlock"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="#dcdcdc"
                                   TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyLocationButton" Content="Copy file:line" Click="CopyLocationButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
